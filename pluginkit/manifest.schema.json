{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.xela.codes/xela/flixur/raw/branch/master/pluginkit/manifest.schema.json",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON schema this manifest is validated against, for editor support.",
      "default": "https://forge.xela.codes/xela/flixur/raw/branch/master/pluginkit/manifest.schema.json"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique Plugin ID."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the plugin."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.(0[1-9]|1[0-2])\\.(0[1-9]|[12]\\d|3[01])$",
      "description": "Version string, formatted YYYY.MM.DD"
    },
    "dependencies": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true,
      "description": "List of plugin IDs that should be loaded before this plugin."
    },
    "features": {
      "items": {
        "type": "string",
        "enum": [
          "MUSIC_METADATA"
        ],
        "description": "Feature IDs this plugin implements, from the Feature enum."
      },
      "type": "array",
      "minItems": 1,
      "description": "List of feature IDs this plugin implements."
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[a-z0-9-]+$",
      "description": "Should be the full identifier of an Iconify icon for this plugin. (https://icon-sets.iconify.design)"
    },
    "description": {
      "type": "string",
      "description": "Short description of the plugin."
    },
    "author": {
      "type": "string",
      "description": "Name of the plugin author."
    },
    "url": {
      "type": "string",
      "description": "Direct link to the source code of the plugin."
    },
    "bin": {
      "type": "string",
      "description": "Absolute path to the binary file to run for the plugin. Only present on the server."
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "features",
    "icon",
    "description",
    "author",
    "url"
  ],
  "title": "Flixur Plugin Manifest",
  "description": "Flixur plugin manifest JSON."
}
